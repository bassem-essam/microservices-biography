{
  "Urls": "http://localhost:5113",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtSettings": {
    "SecretKey": "YourSuperSecretKeyHereMakeItLongAndComplex",
    "Issuer": "YourAppName",
    "Audience": "YourAppClients",
    "ExpirationInMinutes": 60
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AppDbContext": "Server=localhost,1434;Database=master;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=true"
  },
  "spring": {
    "application": {
      "name": "UserService"
    }
  },
  "eureka": {
    "client": {
      "serviceUrl": "http://localhost:8761/eureka/",
      "shouldFetchRegistry": "true",
      "shouldRegisterWithEureka": true,
      "validateCertificates": false
    },
    "instance": {
      "port": "5113",
      "HostName": "localhost"
    }
  }
}
